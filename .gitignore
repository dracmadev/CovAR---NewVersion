# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
sysinfo.txt

# Asset Store Tools plugin (descomenta si no el vols)
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / MonoDevelop
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash Reports
crashlytics-build.properties

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Builds
*.apk
*.aab
*.app
*.exe
*.xcodeproj

# Unity packages
*.unitypackage
*.unitypackage.meta

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary Android StreamingAssets files (ajusta si fa falta)
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*

# === Firebase SDK i fitxers pesats ===

# Ignora carpeta Firebase SDK (canvia si el tens en un altre lloc)
Assets/Firebase/

# Google services config (pots eliminar si vols versionar-los)
Assets/StreamingAssets/google-services.json
Assets/StreamingAssets/GoogleService-Info.plist

# === Plataformes ===

# Android
.gradle/
local.properties

# iOS
build/
Pods/
DerivedData/

# === Altres possibles fitxers grans / temporals ===

*.log
*.temp
*.bak
*.old
*.tgz